{
  "id": "minimax_h3_ref2va_gguf_low_resource",
  "label": "MiniMax H3 REF2VA GGUF Low Resource Workflow",
  "description": "Low-resource clone of the MiniMax H3 REF2VA workflow. The original MiniMax workflow remains the default; this profile exposes per-node device/cache and video VAE chunk/temporal-halo settings.",
  "workflow_file": "workflow.json",
  "aliases": [
    "minimax h3",
    "minimax-h3",
    "minimax-h3-ref2va",
    "minimax-h3-ref2va-gguf",
    "realrebelai/minimax-h3_ggufs",
    "comfy-org/minimax-h3"
  ],
  "backends": [
    "native_graph",
    "comfy_gguf_lazy"
  ],
  "runtime_profile": {
    "kind": "internal_workflow",
    "workflow_id": "minimax_h3_ref2va_gguf_low_resource",
    "workflow_model_loader_id": "models.minimax_h3_ref2va_gguf_low_resource",
    "workflow_model_loader_file": "workflow.json",
    "supports_workflow_model_loader": true,
    "family": "minimax_h3_ref2va_gguf_low_resource",
    "scenario": "video_ref2v_gguf_multi_asset_audio_video",
    "asset_slots": [
      {
        "key": "ref2va_gguf_path",
        "role": "video_transformer_gguf_ref2va",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "*MiniMax*H3*REF2VA*Q4*.gguf",
          "*REF2VA*.gguf",
          "*MiniMax*H3*.gguf"
        ]
      },
      {
        "key": "fl2va_gguf_path",
        "role": "video_transformer_gguf_fl2va",
        "required": false,
        "source": "local_or_hf_file",
        "patterns": [
          "*MiniMax*H3*FL2VA*Q4*.gguf",
          "*MiniMax*H3*FL2VA*Q3*.gguf",
          "*FL2VA*.gguf"
        ]
      },
      {
        "key": "text_encoder_path",
        "role": "text_encoder",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "qwen3vl*MiniMax*H3*.safetensors",
          "*qwen3vl*.safetensors",
          "qwen3vl*MiniMax*H3*.gguf",
          "*qwen3vl*.gguf",
          "*text*encoder*.safetensors",
          "*text*encoder*.gguf"
        ]
      },
      {
        "key": "video_vae_path",
        "role": "video_vae",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "minimax_h3_video_vae*.safetensors",
          "*video*vae*.safetensors"
        ]
      },
      {
        "key": "audio_vae_path",
        "role": "audio_vae",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "minimax_h3_audio_vae*.safetensors",
          "*audio*vae*.safetensors"
        ]
      },
      {
        "key": "reference_image_1_path",
        "role": "reference_image",
        "required": false,
        "source": "local_file",
        "patterns": [
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.webp"
        ]
      },
      {
        "key": "reference_image_2_path",
        "role": "reference_image",
        "required": false,
        "source": "local_file",
        "patterns": [
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.webp"
        ]
      },
      {
        "key": "reference_video_path",
        "role": "reference_video",
        "required": false,
        "source": "local_file",
        "patterns": [
          "*.mp4",
          "*.mov",
          "*.webm"
        ]
      },
      {
        "key": "reference_audio_path",
        "role": "reference_audio",
        "required": false,
        "source": "local_file",
        "patterns": [
          "*.wav",
          "*.mp3",
          "*.flac",
          "*.m4a"
        ]
      },
      {
        "key": "native_gguf_execution_mode",
        "role": "gguf_execution_mode",
        "required": false,
        "source": "setting",
        "default": "comfy_gguf_lazy"
      },
      {
        "key": "minimax_ref_image_size",
        "role": "reference_image_size_policy",
        "required": false,
        "source": "setting",
        "default": "match"
      },
      {
        "key": "minimax_conditioning_mode",
        "role": "minimax_conditioning_mode",
        "required": false,
        "source": "setting",
        "default": "ref2va"
      },
      {
        "key": "minimax_unet_loader",
        "role": "gguf_loader_mode",
        "required": false,
        "source": "setting",
        "default": "advanced"
      },
      {
        "key": "minimax_gguf_dequant_dtype",
        "role": "gguf_dequant_dtype",
        "required": false,
        "source": "setting",
        "default": "bfloat16"
      },
      {
        "key": "minimax_gguf_patch_dtype",
        "role": "gguf_patch_dtype",
        "required": false,
        "source": "setting",
        "default": "bfloat16"
      },
      {
        "key": "minimax_gguf_patch_on_device",
        "role": "gguf_patch_on_device",
        "required": false,
        "source": "setting",
        "default": false
      },
      {
        "key": "minimax_shift_video",
        "role": "video_sigma_shift",
        "required": false,
        "source": "setting",
        "default": 12
      },
      {
        "key": "minimax_shift_audio",
        "role": "audio_sigma_shift",
        "required": false,
        "source": "setting",
        "default": 3
      },
      {
        "key": "minimax_text_encoder_device",
        "role": "text_encoder_device",
        "required": false,
        "source": "setting",
        "default": "cpu",
        "options": [
          {
            "value": "auto",
            "label": "Auto / Comfy default"
          },
          {
            "value": "cpu",
            "label": "CPU"
          },
          {
            "value": "gpu",
            "label": "GPU / main video device"
          }
        ]
      },
      {
        "key": "minimax_text_encoder_cache_mode",
        "role": "text_encoder_cache_mode",
        "required": false,
        "source": "setting",
        "default": "cpu",
        "options": [
          {
            "value": "off",
            "label": "Off / unload after node"
          },
          {
            "value": "cpu",
            "label": "Cache embeddings on CPU"
          },
          {
            "value": "gpu",
            "label": "Cache embeddings on GPU"
          }
        ]
      },
      {
        "key": "minimax_reference_conditioning_device",
        "role": "reference_conditioning_device",
        "required": false,
        "source": "setting",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Auto"
          },
          {
            "value": "cpu",
            "label": "CPU"
          },
          {
            "value": "gpu",
            "label": "GPU / main video device"
          }
        ]
      },
      {
        "key": "minimax_video_vae_device",
        "role": "video_vae_device",
        "required": false,
        "source": "setting",
        "default": "gpu",
        "options": [
          {
            "value": "cpu",
            "label": "CPU"
          },
          {
            "value": "gpu",
            "label": "GPU / main video device"
          }
        ]
      },
      {
        "key": "minimax_video_vae_decode_mode",
        "role": "video_vae_decode_mode",
        "required": false,
        "source": "setting",
        "default": "gpu_temporal_halo",
        "options": [
          {
            "value": "cpu_full",
            "label": "CPU full decode"
          },
          {
            "value": "gpu_full",
            "label": "GPU full decode"
          },
          {
            "value": "gpu_chunked",
            "label": "GPU chunked decode"
          },
          {
            "value": "gpu_temporal_halo",
            "label": "GPU temporal halo decode"
          }
        ]
      },
      {
        "key": "minimax_vae_chunk_latent_frames",
        "role": "video_vae_chunk_latent_frames",
        "required": false,
        "source": "setting",
        "default": 4
      },
      {
        "key": "minimax_vae_chunk_overlap_latent_frames",
        "role": "video_vae_chunk_overlap_latent_frames",
        "required": false,
        "source": "setting",
        "default": 1
      },
      {
        "key": "minimax_vae_chunk_blend_frames",
        "role": "video_vae_chunk_blend_frames",
        "required": false,
        "source": "setting",
        "default": 3
      },
      {
        "key": "minimax_vae_halo_core_latent_frames",
        "role": "video_vae_halo_core_latent_frames",
        "required": false,
        "source": "setting",
        "default": 4
      },
      {
        "key": "minimax_vae_halo_latent_frames",
        "role": "video_vae_halo_latent_frames",
        "required": false,
        "source": "setting",
        "default": 1
      },
      {
        "key": "minimax_vae_halo_max_window_latent_frames",
        "role": "video_vae_halo_max_window_latent_frames",
        "required": false,
        "source": "setting",
        "default": 6
      },
      {
        "key": "minimax_vae_tile_size",
        "role": "video_vae_tile_size",
        "required": false,
        "source": "setting",
        "default": 512
      },
      {
        "key": "minimax_vae_tile_overlap",
        "role": "video_vae_tile_overlap",
        "required": false,
        "source": "setting",
        "default": 64
      },
      {
        "key": "minimax_audio_vae_device",
        "role": "audio_vae_device",
        "required": false,
        "source": "setting",
        "default": "cpu",
        "options": [
          {
            "value": "cpu",
            "label": "CPU"
          },
          {
            "value": "gpu",
            "label": "GPU / main video device"
          }
        ]
      },
      {
        "key": "minimax_enable_audio",
        "role": "audio_mux_enabled",
        "required": false,
        "source": "setting",
        "default": false
      }
    ],
    "loader_steps": [
      {
        "id": "text_encoder",
        "kind": "gguf_text_encoder",
        "role": "text_encoder_gguf",
        "source_setting": "text_encoder_gguf_path",
        "class_name": "CLIPLoaderGGUF",
        "clip_type": "wan"
      },
      {
        "id": "ref2va_transformer",
        "kind": "gguf_transformer",
        "role": "video_transformer_gguf_ref2va",
        "source_setting": "ref2va_gguf_path",
        "class_name": "UnetLoaderGGUF"
      },
      {
        "id": "ref2v_conditioning",
        "kind": "reference_to_video_conditioning",
        "handler": "minimax_h3_reference_to_video",
        "source_settings": [
          "reference_image_1_path",
          "reference_image_2_path",
          "reference_video_path",
          "reference_audio_path"
        ]
      },
      {
        "id": "sampler",
        "kind": "sampler_stage",
        "handler": "minimax_h3_sampler"
      },
      {
        "id": "video_vae",
        "kind": "support_asset",
        "role": "video_vae",
        "source_setting": "video_vae_path"
      },
      {
        "id": "audio_vae",
        "kind": "support_asset",
        "role": "audio_vae",
        "source_setting": "audio_vae_path"
      }
    ]
  },
  "requirements": [
    {
      "id": "torch",
      "label": "PyTorch",
      "kind": "python_package",
      "package": "torch",
      "import_name": "torch",
      "install": [
        "torch"
      ],
      "uninstall": [
        "torch"
      ]
    },
    {
      "id": "gguf",
      "label": "gguf",
      "kind": "python_package",
      "package": "gguf",
      "import_name": "gguf",
      "install": [
        "gguf"
      ],
      "uninstall": [
        "gguf"
      ]
    },
    {
      "id": "imageio_ffmpeg",
      "label": "imageio-ffmpeg",
      "kind": "python_package",
      "package": "imageio-ffmpeg",
      "import_name": "imageio_ffmpeg",
      "install": [
        "imageio-ffmpeg"
      ],
      "uninstall": [
        "imageio-ffmpeg"
      ]
    }
  ],
  "workflow_defaults": {
    "model_id": "MiniMax-H3-REF2VA-GGUF",
    "model_family": "minimax_h3_ref2va_gguf_low_resource",
    "workflow_variant": "ref2va_gguf_low_resource",
    "runtime_adapter": "minimax_h3",
    "workflow_adapter": "minimax_h3",
    "workflow_loader_mode": "workflow_model_loader",
    "workflow_execution_backend": "native_graph",
    "workflow_node_lifecycle_policy": "lazy_unload",
    "device": "xpu",
    "dtype": "bfloat16",
    "native_gguf_execution_mode": "comfy_gguf_lazy",
    "native_lazy_quantized_packed_device": "cpu",
    "native_transformer_offload": "cpu_slots",
    "width": 864,
    "height": 480,
    "duration_seconds": 1,
    "fps": 24,
    "frames": 22,
    "steps": 20,
    "guidance_scale": 1,
    "sampler_name": "res_multistep",
    "scheduler": "simple",
    "minimax_ref_image_size": "match",
    "minimax_conditioning_mode": "ref2va",
    "minimax_unet_loader": "basic",
    "minimax_gguf_dequant_dtype": "default",
    "minimax_gguf_patch_dtype": "default",
    "minimax_gguf_patch_on_device": false,
    "minimax_resize_references": true,
    "minimax_ref1_width": 512,
    "minimax_ref1_height": 512,
    "minimax_ref2_width": 1024,
    "minimax_ref2_height": 576,
    "minimax_shift_video": 12,
    "minimax_shift_audio": 3,
    "minimax_text_encoder_device": "cpu",
    "minimax_text_encoder_cache_mode": "cpu",
    "minimax_reference_conditioning_device": "auto",
    "minimax_video_vae_decode_mode": "gpu_temporal_halo",
    "minimax_video_vae_device": "gpu",
    "minimax_vae_chunk_latent_frames": 4,
    "minimax_vae_chunk_overlap_latent_frames": 1,
    "minimax_vae_chunk_blend_frames": 3,
    "minimax_vae_halo_core_latent_frames": 4,
    "minimax_vae_halo_latent_frames": 1,
    "minimax_vae_halo_max_window_latent_frames": 6,
    "minimax_vae_tile_size": 512,
    "minimax_vae_tile_overlap": 64,
    "minimax_audio_vae_device": "cpu",
    "minimax_enable_audio": false,
    "minimax_rtx_upscale_enabled": false,
    "minimax_rtx_upscale_mode": "scale by multiplier",
    "minimax_rtx_upscale_multiplier": 2,
    "minimax_rtx_upscale_quality": "ULTRA",
    "gguf_path": "${MODEL_DECK_MODELS_DIR}/minimax_h3/diffusion_models/ref2va/minimax_h3_ref2va-Q4_K_M.gguf",
    "ref2va_gguf_path": "${MODEL_DECK_MODELS_DIR}/minimax_h3/diffusion_models/ref2va/minimax_h3_ref2va-Q4_K_M.gguf",
    "fl2va_gguf_path": "${MODEL_DECK_MODELS_DIR}/minimax_h3/diffusion_models/MiniMax-H3-FL2VA-Q4_K_M.gguf",
    "clip_type": "minimax",
    "text_encoder_path": "${MODEL_DECK_MODELS_DIR}/minimax_h3/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
    "text_encoder_safetensors_path": "${MODEL_DECK_MODELS_DIR}/minimax_h3/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
    "text_encoder_gguf_path": "${MODEL_DECK_MODELS_DIR}/minimax_h3/text_encoders/qwen3vl-32B-MiniMax-H3-Q4_K_M.gguf",
    "video_vae_path": "${MODEL_DECK_MODELS_DIR}/minimax_h3/vae/minimax_h3_video_vae_fp16.safetensors",
    "audio_vae_path": "${MODEL_DECK_MODELS_DIR}/minimax_h3/vae/minimax_h3_audio_vae_fp32.safetensors",
    "model_deck_compat_manifest_id": "minimax_h3_ref2va_gguf_low_resource",
    "model_workflow_flow_name": "Models / MiniMax H3 REF2VA GGUF Low Resource",
    "model_workflow_template_flow_name": "Models / MiniMax H3 REF2VA GGUF Low Resource",
    "model_workflow_owned": false
  },
  "loader_steps": [
    {
      "id": "resolve_assets",
      "label": "Resolve MiniMax H3 assets"
    },
    {
      "id": "reference_inputs",
      "label": "Load reference image/video/audio inputs"
    },
    {
      "id": "encode_prompt",
      "label": "Encode prompt with Qwen3VL"
    },
    {
      "id": "load_ref2va_transformer",
      "label": "Load REF2VA GGUF transformer"
    },
    {
      "id": "ref2v_conditioning",
      "label": "Build MiniMax reference-to-video conditioning"
    },
    {
      "id": "sample_latents",
      "label": "Sample video/audio latents"
    },
    {
      "id": "decode_video_vae",
      "label": "Decode MiniMax video VAE"
    },
    {
      "id": "decode_audio_vae",
      "label": "Decode MiniMax audio VAE"
    },
    {
      "id": "rtx_upscale",
      "label": "Optional RTX upscale"
    },
    {
      "id": "encode_mp4",
      "label": "Mux MP4"
    },
    {
      "id": "cleanup",
      "label": "Release workflow resources"
    }
  ]
}
