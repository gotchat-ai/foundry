{
  "id": "wan22_t2v_gguf",
  "label": "Wan2.2 T2V GGUF Workflow",
  "description": "Tested-profile skeleton for ComfyUI-style Wan2.2 T2V GGUF workflows with paired HighNoise/LowNoise UNets, UMT5 GGUF text encoder, Wan VAE, optional LoRA stages, optional RIFE interpolation, and staged sampling.",
  "workflow_file": "workflow.json",
  "aliases": [
    "wan2.2",
    "wan 2.2",
    "wan2.2 t2v",
    "wan2.2-t2v-a14b",
    "wan2.2-t2v-a14b-gguf",
    "wan2.2-t2v-a14b-highnoise",
    "wan2.2-t2v-a14b-lownoise",
    "quantstack/wan2.2-t2v-a14b-gguf"
  ],
  "backends": [
    "native_graph",
    "diffusers"
  ],
  "runtime_profile": {
    "kind": "internal_workflow",
    "workflow_id": "wan22_t2v_gguf",
    "workflow_model_loader_id": "models.wan22_t2v_gguf",
    "workflow_model_loader_file": "workflow.json",
    "supports_workflow_model_loader": true,
    "family": "wan22_t2v_gguf",
    "scenario": "video_gguf_dual_transformer_staged_sampler",
    "asset_slots": [
      {
        "key": "high_noise_gguf_path",
        "role": "video_transformer_gguf_high_noise",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "*HighNoise*.gguf",
          "*high*noise*.gguf",
          "*Wan2.2*T2V*A14B*HighNoise*.gguf"
        ]
      },
      {
        "key": "low_noise_gguf_path",
        "role": "video_transformer_gguf_low_noise",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "*LowNoise*.gguf",
          "*low*noise*.gguf",
          "*Wan2.2*T2V*A14B*LowNoise*.gguf"
        ]
      },
      {
        "key": "text_encoder_gguf_path",
        "role": "text_encoder_gguf",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "umt5*.gguf",
          "*umt5*encoder*.gguf"
        ]
      },
      {
        "key": "video_vae_path",
        "role": "video_vae",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "wan*vae*.safetensors",
          "wan_2.1_vae.safetensors"
        ]
      },
      {
        "key": "high_noise_lora_path",
        "role": "optional_high_noise_lora",
        "required": false,
        "source": "local_or_hf_file",
        "patterns": [
          "*high*noise*lora*.safetensors",
          "*wan*lora*.safetensors"
        ]
      },
      {
        "key": "low_noise_lora_path",
        "role": "optional_low_noise_lora",
        "required": false,
        "source": "local_or_hf_file",
        "patterns": [
          "*low*noise*lora*.safetensors",
          "*wan*lora*.safetensors"
        ]
      },
      {
        "key": "frame_interpolator_model_path",
        "role": "optional_frame_interpolator",
        "required": false,
        "source": "local_or_hf_file",
        "patterns": [
          "rife*.pth",
          "rife*.pt"
        ]
      },
      {
        "key": "workflow_loader_mode",
        "role": "workflow_loader_mode",
        "required": false,
        "source": "setting",
        "default": "workflow_model_loader"
      },
      {
        "key": "workflow_execution_backend",
        "role": "workflow_execution_backend",
        "required": false,
        "source": "setting",
        "default": "native_graph"
      },
      {
        "key": "workflow_node_lifecycle_policy",
        "role": "node_lifecycle_policy",
        "required": false,
        "source": "setting",
        "default": "lazy_unload"
      },
      {
        "key": "latent_format",
        "role": "latent_video_format",
        "required": false,
        "source": "setting",
        "default": "hunyuan_video"
      },
      {
        "key": "high_noise_steps",
        "role": "high_noise_steps",
        "required": false,
        "source": "setting",
        "default": 4
      },
      {
        "key": "low_noise_steps",
        "role": "low_noise_steps",
        "required": false,
        "source": "setting",
        "default": 6
      },
      {
        "key": "shift",
        "role": "model_sampling_shift",
        "required": false,
        "source": "setting",
        "default": 8
      },
      {
        "key": "sampler_name",
        "role": "sampler_name",
        "required": false,
        "source": "setting",
        "default": "euler"
      },
      {
        "key": "scheduler",
        "role": "scheduler",
        "required": false,
        "source": "setting",
        "default": "simple"
      },
      {
        "key": "target_fps",
        "role": "interpolated_output_fps",
        "required": false,
        "source": "setting",
        "default": 60
      },
      {
        "key": "wan_vae_decode_mode",
        "role": "wan_vae_decode_mode",
        "required": false,
        "source": "setting",
        "default": "gpu_chunked_safe",
        "options": [
          {
            "value": "cpu_safe",
            "label": "CPU safe VAE decode"
          },
          {
            "value": "gpu_full",
            "label": "GPU full VAE decode"
          },
          {
            "value": "gpu_chunked_safe",
            "label": "GPU chunked safe VAE decode"
          }
        ]
      },
      {
        "key": "wan_vae_chunk_latent_frames",
        "role": "wan_vae_chunk_latent_frames",
        "required": false,
        "source": "setting",
        "default": 1
      },
      {
        "key": "wan_vae_decode_device",
        "role": "wan_vae_decode_device",
        "required": false,
        "source": "setting",
        "default": "gpu",
        "options": [
          {
            "value": "cpu",
            "label": "CPU"
          },
          {
            "value": "gpu",
            "label": "GPU / main video device"
          }
        ]
      },
      {
        "key": "wan_vae_dtype",
        "role": "wan_vae_dtype",
        "required": false,
        "source": "setting",
        "default": "bfloat16",
        "options": [
          {
            "value": "bfloat16",
            "label": "bfloat16"
          },
          {
            "value": "float32",
            "label": "float32"
          },
          {
            "value": "float16",
            "label": "float16"
          }
        ]
      }
    ],
    "loader_steps": [
      {
        "id": "text_encoder",
        "kind": "gguf_text_encoder",
        "role": "text_encoder_gguf",
        "source_setting": "text_encoder_gguf_path",
        "class_name": "CLIPLoaderGGUF",
        "clip_type": "wan"
      },
      {
        "id": "high_noise_transformer",
        "kind": "gguf_transformer_stage",
        "role": "video_transformer_gguf_high_noise",
        "source_setting": "high_noise_gguf_path",
        "stage": "high_noise",
        "handler": "wan22_stage_transformer_loader"
      },
      {
        "id": "high_noise_sampler",
        "kind": "sampler_stage",
        "model_stage": "high_noise",
        "steps_setting": "high_noise_steps",
        "handler": "wan22_stage_sampler"
      },
      {
        "id": "release_high_noise_transformer",
        "kind": "release_model",
        "model_stage": "high_noise",
        "handler": "wan22_release_transformer"
      },
      {
        "id": "low_noise_transformer",
        "kind": "gguf_transformer_stage",
        "role": "video_transformer_gguf_low_noise",
        "source_setting": "low_noise_gguf_path",
        "stage": "low_noise",
        "handler": "wan22_stage_transformer_loader"
      },
      {
        "id": "low_noise_sampler",
        "kind": "sampler_stage",
        "model_stage": "low_noise",
        "steps_setting": "low_noise_steps",
        "handler": "wan22_stage_sampler"
      },
      {
        "id": "release_low_noise_transformer",
        "kind": "release_model",
        "model_stage": "low_noise",
        "handler": "wan22_release_transformer"
      },
      {
        "id": "vae",
        "kind": "support_asset",
        "role": "video_vae",
        "source_setting": "video_vae_path",
        "class_name": "AutoencoderKLWan",
        "class_module": "diffusers"
      },
      {
        "id": "rife_interpolator",
        "kind": "optional_postprocess",
        "role": "optional_frame_interpolator",
        "source_setting": "frame_interpolator_model_path"
      }
    ]
  },
  "requirements": [
    {
      "id": "torch",
      "label": "PyTorch",
      "kind": "python_package",
      "package": "torch",
      "import_name": "torch",
      "install": [
        "torch"
      ],
      "uninstall": [
        "torch"
      ]
    },
    {
      "id": "gguf",
      "label": "gguf",
      "kind": "python_package",
      "package": "gguf",
      "import_name": "gguf",
      "install": [
        "gguf"
      ],
      "uninstall": [
        "gguf"
      ]
    },
    {
      "id": "diffusers",
      "label": "diffusers",
      "kind": "python_package",
      "package": "diffusers",
      "import_name": "diffusers",
      "install": [
        "diffusers"
      ],
      "uninstall": [
        "diffusers"
      ]
    },
    {
      "id": "transformers",
      "label": "transformers",
      "kind": "python_package",
      "package": "transformers",
      "import_name": "transformers",
      "install": [
        "transformers"
      ],
      "uninstall": [
        "transformers"
      ]
    },
    {
      "id": "imageio_ffmpeg",
      "label": "imageio-ffmpeg",
      "kind": "python_package",
      "package": "imageio-ffmpeg",
      "import_name": "imageio_ffmpeg",
      "install": [
        "imageio-ffmpeg"
      ],
      "uninstall": [
        "imageio-ffmpeg"
      ]
    }
  ]
}
