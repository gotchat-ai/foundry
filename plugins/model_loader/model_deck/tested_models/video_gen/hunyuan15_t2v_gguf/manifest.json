{
  "id": "hunyuan15_t2v_gguf",
  "label": "HunyuanVideo 1.5 T2V GGUF Workflow",
  "description": "HunyuanVideo 1.5 text-to-video GGUF native graph workflow.",
  "workflow_file": "workflow.json",
  "aliases": [
    "hunyuan 1.5",
    "hunyuanvideo 1.5",
    "hunyuan15_t2v_gguf",
    "jayn7/HunyuanVideo-1.5_T2V_720p-GGUF",
    "jayn7/HunyuanVideo-1.5_I2V_720p-GGUF"
  ],
  "backends": [
    "native_graph",
    "comfy_gguf_lazy"
  ],
  "runtime_profile": {
    "kind": "internal_workflow",
    "workflow_id": "hunyuan15_t2v_gguf",
    "workflow_model_loader_id": "models.hunyuan15_t2v_gguf",
    "workflow_model_loader_file": "workflow.json",
    "supports_workflow_model_loader": true,
    "family": "hunyuan15_t2v_gguf",
    "scenario": "hunyuan15_t2v_gguf",
    "asset_slots": [
      {
        "key": "hunyuan_gguf_path",
        "role": "video_transformer_gguf",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "*HunyuanVideo*1.5*720p*.gguf",
          "*hunyuan*video*Q5*.gguf",
          "*.gguf"
        ]
      },
      {
        "key": "video_vae_path",
        "role": "video_vae",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "hunyuanvideo15*vae*.safetensors",
          "hunyuan_video_vae*.safetensors",
          "*vae*.safetensors"
        ]
      },
      {
        "key": "text_encoder_1_path",
        "role": "text_encoder_1",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "qwen_2.5_vl*.safetensors",
          "Long-ViT*.safetensors"
        ]
      },
      {
        "key": "text_encoder_2_path",
        "role": "text_encoder_2",
        "required": true,
        "source": "local_or_hf_file",
        "patterns": [
          "byt5_small*.safetensors",
          "llava_llama3*.safetensors"
        ]
      },
      {
        "key": "source_image_path",
        "role": "source_image",
        "required": false,
        "source": "local_file",
        "patterns": [
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.webp"
        ]
      },
      {
        "key": "hunyuan_fast_lora_path",
        "role": "fast_lora",
        "required": false,
        "source": "local_or_hf_file",
        "patterns": [
          "*FastVideo*LoRA*.safetensors",
          "*.safetensors"
        ]
      },
      {
        "key": "hunyuan_leapfusion_lora_path",
        "role": "i2v_leapfusion_lora",
        "required": false,
        "source": "local_or_hf_file",
        "patterns": [
          "*img2vid*.safetensors",
          "*LeapFusion*.safetensors"
        ]
      },
      {
        "key": "upscale_model_path",
        "role": "latent_upscaler",
        "required": false,
        "source": "local_or_hf_file",
        "patterns": [
          "*upscale*.safetensors",
          "*upscaler*.safetensors"
        ]
      }
    ]
  },
  "requirements": [
    {
      "id": "torch",
      "label": "PyTorch",
      "kind": "python_package",
      "package": "torch",
      "import_name": "torch",
      "install": [
        "torch"
      ],
      "uninstall": [
        "torch"
      ]
    },
    {
      "id": "gguf",
      "label": "gguf",
      "kind": "python_package",
      "package": "gguf",
      "import_name": "gguf",
      "install": [
        "gguf"
      ],
      "uninstall": [
        "gguf"
      ]
    },
    {
      "id": "imageio_ffmpeg",
      "label": "imageio-ffmpeg",
      "kind": "python_package",
      "package": "imageio-ffmpeg",
      "import_name": "imageio_ffmpeg",
      "install": [
        "imageio-ffmpeg"
      ],
      "uninstall": [
        "imageio-ffmpeg"
      ]
    }
  ],
