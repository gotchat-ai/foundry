{
  "id": "flux_diffusers",
  "label": "FLUX Diffusers",
  "description": "Tested FLUX diffusers profile with the standard Python pipeline stack.",
  "aliases": [
    "flux.1",
    "black-forest-labs/flux",
    "flux"
  ],
  "backends": [
    "diffusers"
  ],
  "diffusers_loader": {
    "pipeline_class": "FluxPipeline",
    "pipeline_module": "diffusers",
    "pipeline_load_method": "from_pretrained",
    "pipeline_source_setting": "model_id",
    "pipeline_source_default": "black-forest-labs/FLUX.1-dev",
    "pipeline_inject_key": "transformer",
    "pipeline_kwargs_from_settings": [
      {
        "setting": "text_encoder_path"
      },
      {
        "setting": "vae_path"
      },
      {
        "setting": "clip_path"
      },
      {
        "setting": "low_cpu_mem_usage"
      }
    ],
    "transformer_class": "FluxTransformer2DModel",
    "transformer_module": "diffusers",
    "transformer_load_method": "from_single_file",
    "transformer_source_setting": "gguf_path",
    "transformer_static_kwargs": {
      "config": "black-forest-labs/FLUX.1-dev",
      "subfolder": "transformer"
    },
    "transformer_quantization_class": "GGUFQuantizationConfig",
    "transformer_quantization_module": "diffusers"
  },
  "requirements": [
    {
      "id": "torch",
      "label": "PyTorch",
      "kind": "python_package",
      "package": "torch",
      "import_name": "torch",
      "install": [
        "torch"
      ],
      "uninstall": [
        "torch"
      ]
    },
    {
      "id": "diffusers",
      "label": "diffusers",
      "kind": "python_package",
      "package": "diffusers",
      "import_name": "diffusers",
      "install": [
        "diffusers"
      ],
      "uninstall": [
        "diffusers"
      ]
    },
    {
      "id": "flux_pipeline",
      "label": "FluxPipeline",
      "kind": "python_symbol",
      "module": "diffusers",
      "symbol": "FluxPipeline",
      "install": [
        "diffusers"
      ],
      "uninstall": []
    },
    {
      "id": "transformers",
      "label": "transformers",
      "kind": "python_package",
      "package": "transformers",
      "import_name": "transformers",
      "install": [
        "transformers"
      ],
      "uninstall": [
        "transformers"
      ]
    },
    {
      "id": "accelerate",
      "label": "accelerate",
      "kind": "python_package",
      "package": "accelerate",
      "import_name": "accelerate",
      "install": [
        "accelerate"
      ],
      "uninstall": [
        "accelerate"
      ]
    }
  ]
}
