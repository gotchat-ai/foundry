{
  "recommended_loader_id": "model_loader.model_deck.diffusers",
  "fields": [
    {
      "key": "backend",
      "type": "enum",
      "choices": [
        "diffusers"
      ],
      "default": "diffusers",
      "label": "Backend"
    },
    {
      "key": "model_backend",
      "type": "enum",
      "choices": [
        { "value": "default", "label": "Default" },
        { "value": "workflow", "label": "Workflow" }
      ],
      "default": "default",
      "label": "Model Backend",
      "description": "Default uses the normal built-in edit fields. Workflow uses the Agent Flow native staged graph for this model."
    },
    {
      "key": "image_command_mode",
      "type": "enum",
      "choices": [
        { "value": "standard", "label": "Built-in backend routing" },
        { "value": "advanced", "label": "Custom command template" }
      ],
      "default": "standard",
      "label": "Execution mode",
      "description": "Use built-in diffusers / sd_cpp routing by default, or switch to a fully custom command template."
    },
    {
      "key": "workflow_loader_mode",
      "type": "enum",
      "choices": [
        { "value": "checkpoint_runner", "label": "Built-in runner" },
        { "value": "workflow_model_loader", "label": "Workflow model loader" }
      ],
      "default": "checkpoint_runner",
      "label": "Model workflow mode",
      "ui_hidden": true,
      "description": "For tested workflow profiles, keep the built-in route or opt into the node-based workflow model loader."
    },
    {
      "key": "workflow_node_lifecycle_policy",
      "type": "enum",
      "choices": [
        { "value": "lazy_unload", "label": "Lazy load, unload after node" },
        { "value": "lazy_persist", "label": "Lazy load, persist until cleanup" },
        { "value": "preload_persist", "label": "Preload and persist" }
      ],
      "default": "lazy_unload",
      "label": "Workflow node lifecycle",
      "description": "Controls resource behavior for workflow-model-loader nodes."
    },
    {
      "key": "workflow_execution_backend",
      "type": "enum",
      "choices": [
        { "value": "built_in_runner", "label": "Built-in runner" },
        { "value": "native_graph", "label": "Native staged graph execution" },
        { "value": "native_comfyui_gguf", "label": "Native ComfyUI-GGUF graph backend (experimental)" }
      ],
      "default": "built_in_runner",
      "label": "Workflow execution backend",
      "ui_hidden": true,
      "description": "Selects how terminal model workflow nodes execute for image models."
    },
    {
      "key": "workflow_node_timeout_s",
      "type": "number",
      "default": 10800,
      "label": "Workflow node timeout (seconds)",
      "description": "Maximum time allowed for a terminal workflow execution node."
    },
    {
      "key": "comfyui_runtime_root",
      "type": "path",
      "required": false,
      "label": "ComfyUI runtime root",
      "ui_hidden": true,
      "description": "Optional path to a full ComfyUI checkout. Needed for the native ComfyUI-GGUF backend because the GGUF custom node imports comfy.*, nodes, and folder_paths."
    },
    {
      "key": "comfyui_gguf_vendor_root",
      "type": "path",
      "required": false,
      "default": "C:/Users/Tee/projects/llmloader2/vendor/ComfyUI-GGUF",
      "label": "ComfyUI-GGUF vendor root",
      "ui_hidden": true,
      "description": "Path to the vendored ComfyUI-GGUF custom node code."
    },
    {
      "key": "image_template_preset",
      "type": "enum",
      "choices": [
        { "value": "generic_diffusers", "label": "Generic Diffusers" },
        { "value": "flux_gguf_custom", "label": "Flux GGUF custom runner" },
        { "value": "gguf_cli_custom", "label": "Generic GGUF CLI" }
      ],
      "default": "generic_diffusers",
      "label": "Template preset",
      "description": "Prefills example JSON for custom image generation commands."
    },
    {
      "key": "image_runtime_template_json",
      "type": "textarea",
      "rows": 10,
      "required": false,
      "label": "Custom command template JSON",
      "description": "Advanced mode only. Full argv template for your external image generator."
    },
    {
      "key": "image_runtime_assets_json",
      "type": "textarea",
      "rows": 6,
      "required": false,
      "label": "Custom asset JSON",
      "description": "Advanced mode only. Paths or static assets referenced by the template."
    },
    {
      "key": "image_runtime_params_json",
      "type": "textarea",
      "rows": 6,
      "required": false,
      "label": "Custom parameter JSON",
      "description": "Advanced mode only. Optional defaults merged into the runtime template placeholders."
    },
    {
      "key": "image_runtime_extra_args",
      "type": "str",
      "required": false,
      "label": "Custom extra args",
      "description": "Advanced mode only. Extra args appended after the rendered command template."
    },
    {
      "key": "model_id",
      "type": "str",
      "required": false,
      "label": "Model id/path (base pipeline)"
    },
    {
      "key": "diffusers_pipeline_class",
      "type": "str",
      "required": false,
      "label": "Pipeline class name",
      "description": "Auto-filled from the matched tested profile when known. Leave blank to use the profile default."
    },
    {
      "key": "diffusers_transformer_class",
      "type": "str",
      "required": false,
      "label": "Transformer class name",
      "description": "Auto-filled from the matched tested profile when known. Leave blank to use the profile default."
    },
    {
      "key": "gguf_path",
      "type": "path",
      "required": false,
      "label": "GGUF path (diffusers gguf / sd_cpp / gguf_cli)"
    },
    {
      "key": "text_encoder_path",
      "type": "path",
      "required": false,
      "label": "Text encoder path (diffusers gguf)"
    },
    {
      "key": "use_unet",
      "type": "bool",
      "required": false,
      "label": "Use UNet override"
    },
    {
      "key": "sdxl_unet_path",
      "type": "path",
      "required": false,
      "label": "UNet path (safetensors)"
    },
    {
      "key": "sdxl_unet_repo",
      "type": "str",
      "required": false,
      "label": "UNet repo (HF)"
    },
    {
      "key": "sdxl_unet_filename",
      "type": "str",
      "required": false,
      "label": "UNet filename"
    },
    {
      "key": "sdxl_base_model",
      "type": "str",
      "required": false,
      "label": "Base model id"
    },
    {
      "key": "sdxl_variant",
      "type": "str",
      "required": false,
      "label": "Variant (e.g., fp16)"
    },
    {
      "key": "sdxl_timestep_spacing",
      "type": "enum",
      "choices": [
        "trailing",
        "leading",
        "linspace"
      ],
      "default": "trailing",
      "label": "Timestep spacing"
    },
    {
      "key": "vae_path",
      "type": "path",
      "required": false,
      "label": "VAE path (diffusers gguf / sd_cpp)"
    },
    {
      "key": "clip_path",
      "type": "path",
      "required": false,
      "label": "CLIP path (optional, diffusers gguf)"
    },
    {
      "key": "gguf_filename",
      "type": "str",
      "required": false,
      "label": "GGUF filename (if gguf_path is HF repo)"
    },
    {
      "key": "hf_token",
      "type": "str",
      "required": false,
      "label": "Hugging Face token (gated repos)"
    },
    {
      "key": "dtype",
      "type": "enum",
      "choices": [
        "auto",
        "fp16",
        "bf16",
        "fp32"
      ],
      "default": "auto",
      "label": "Torch dtype (diffusers)"
    },
    {
      "key": "device",
      "type": "enum",
      "choices": [
        "auto",
        "cuda",
        "xpu",
        "cpu",
        "mps"
      ],
      "default": "auto",
      "label": "Device (diffusers)"
    },
    {
      "key": "gpu_selection_mode",
      "type": "enum",
      "choices": [
        { "value": "auto", "label": "Automatic device selection" },
        { "value": "single", "label": "Single GPU/device index" }
      ],
      "default": "auto",
      "label": "GPU selection mode (diffusers)"
    },
    {
      "key": "main_gpu",
      "type": "int",
      "default": 0,
      "label": "GPU device id (diffusers)"
    },
    {
      "key": "enable_model_cpu_offload",
      "type": "bool",
      "required": false,
      "label": "Enable model CPU offload (diffusers)"
    },
    {
      "key": "enable_sequential_cpu_offload",
      "type": "bool",
      "required": false,
      "label": "Enable sequential CPU offload (diffusers)"
    },
    {
      "key": "max_sequence_length",
      "type": "int",
      "required": false,
      "label": "Max sequence length (Flux)"
    },
    {
      "key": "low_cpu_mem_usage",
      "type": "bool",
      "required": false,
      "label": "Low CPU mem usage (diffusers)"
    },
    {
      "key": "cli_path",
      "type": "path",
      "required": false,
      "label": "GGUF CLI path (image generator binary)"
    },
    {
      "key": "cli_args",
      "type": "str",
      "required": false,
      "label": "CLI args template (uses {model_path}, {prompt}, {out_path}, {width}, {height}, {steps}, {guidance}, {negative_prompt}, {seed}, {seed_arg})"
    },
    {
      "key": "output_ext",
      "type": "enum",
      "choices": [
        "png",
        "jpg",
        "jpeg",
        "webp"
      ],
      "default": "png",
      "label": "Output format"
    },
    {
      "key": "clip_l_path",
      "type": "path",
      "required": false,
      "label": "CLIP-L path (sd_cpp)"
    },
    {
      "key": "clip_g_path",
      "type": "path",
      "required": false,
      "label": "CLIP-G path (sd_cpp)"
    },
    {
      "key": "t5xxl_path",
      "type": "path",
      "required": false,
      "label": "T5-XXL path (sd_cpp)"
    },
    {
      "key": "t5_path",
      "type": "path",
      "required": false,
      "label": "T5 path (sd_cpp)"
    },
    {
      "key": "n_threads",
      "type": "int",
      "required": false,
      "label": "Threads (sd_cpp)"
    },
    {
      "key": "n_gpu_layers",
      "type": "int",
      "required": false,
      "label": "GPU layers (sd_cpp)"
    },
    {
      "key": "device",
      "type": "str",
      "required": false,
      "label": "Device (sd_cpp)"
    },
    {
      "key": "sdcpp_kwargs",
      "type": "object",
      "required": false,
      "label": "Extra kwargs (sd_cpp)"
    },
    {
      "key": "timeout_s",
      "type": "int",
      "default": 300,
      "label": "CLI timeout (seconds)"
    },
    {
      "key": "steps",
      "type": "int",
      "default": 28,
      "label": "Steps"
    },
    {
      "key": "cfg_scale",
      "type": "float",
      "default": 3.5,
      "label": "CFG scale"
    },
    {
      "key": "width",
      "type": "int",
      "default": 1024,
      "label": "Width"
    },
    {
      "key": "height",
      "type": "int",
      "default": 1024,
      "label": "Height"
    },
    {
      "key": "sampler",
      "type": "enum",
      "choices": [
        "euler",
        "euler_a",
        "dpmpp_2m",
        "ddim"
      ],
      "default": "euler",
      "label": "Sampler"
    },
    {
      "key": "seed",
      "type": "int",
      "default": -1,
      "label": "Seed (-1=random)"
    }
  ]
}
