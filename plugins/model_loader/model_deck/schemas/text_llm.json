      "type": "bool",
      "default": false,
      "label": "Flash Attention (if supported)"
    },
    {
      "key": "kv_unified",
      "type": "bool",
      "default": null,
      "label": "Unified KV cache buffer"
    },
    {
      "key": "no_host",
      "type": "bool",
      "default": null,
      "label": "Disable host buffer (--no-host)"
    },
    {
      "key": "cache_ram",
      "type": "int",
      "default": null,
      "label": "Prompt cache RAM MiB (0=disable)"
    },
    {
      "key": "mmap",
      "type": "bool",
      "default": null,
      "label": "Memory-map model file"
    },
    {
      "key": "ctx_checkpoints",
      "type": "int",
      "default": null,
      "label": "Context checkpoints per slot"
    },
    {
      "key": "emit_thinking",
      "type": "bool",
      "default": false,
      "label": "Emit thinking / reasoning"
    },
    {
      "key": "think_style",
      "type": "text",
      "default": "planner",
      "label": "Thinking style"
    },
    {
      "key": "rope_freq_base",
      "type": "float",
      "default": null,
      "allow_auto": true,
      "label": "RoPE frequency base"
    },
    {
      "key": "rope_freq_scale",
      "type": "float",
      "default": null,
      "allow_auto": true,
      "label": "RoPE frequency scale"
    },
    {
      "key": "temp",
      "type": "float",
      "default": 0.7,
      "label": "Temperature"
    },
    {
      "key": "top_p",
      "type": "float",
      "default": 0.95,
      "label": "Top-p"
    },
    {
      "key": "top_k",
      "type": "int",
      "default": 40,
      "label": "Top-k"
    },
    {
      "key": "repeat_penalty",
      "type": "float",
      "default": 1.05,
      "label": "Repeat penalty"
