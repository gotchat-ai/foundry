      "required": true,
      "label": "GGUF model path"
    },
    {
      "key": "mmproj_path",
      "type": "path",
      "required": false,
      "label": "MMProj / vision proj path (optional)"
    },
    {
      "key": "lora_adapter_path",
      "type": "path",
      "required": false,
      "label": "LoRA adapter path (optional)"
    },
    {
      "key": "lora_base_model_path",
      "type": "path",
      "required": false,
      "label": "LoRA base model path (optional)"
    },
    {
      "key": "lora_scale",
      "type": "float",
      "default": null,
      "label": "LoRA scale"
    },
    {
      "key": "n_ctx",
      "type": "int",
      "default": 8192,
      "label": "Context length"
    },
    {
      "key": "n_batch",
      "type": "int",
      "default": 512,
      "label": "Batch size (n_batch)"
    },
    {
      "key": "ubatch_size",
      "type": "int",
      "default": 512,
      "label": "Micro-batch size (n_ubatch)"
