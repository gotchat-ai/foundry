    "/v1/agent_workflow/status/{workflow_id}",
    "/v1/agent_workflow/cancel/{workflow_id}",
    "/v1/agent_workflow/feedback",
    "/v1/agent_workflow/learning",
    "/v1/agent_workflow/tools",
    "/v1/agent_workflow/profiles",
    "/v1/agent_workflow/profiles/reload"
