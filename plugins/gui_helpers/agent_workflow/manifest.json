{
  "id": "agent_workflow",
  "name": "Agent Workflow",
  "version": "0.1.0",
  "description": "Workflow orchestration API skeleton with typed contracts and phase-1 trace/status plumbing.",
  "dependencies": [
    "collab_chat",
    "repo_context"
  ],
  "routes": [
    "/v1/agent_workflow/run",
    "/v1/agent_workflow/stream",
